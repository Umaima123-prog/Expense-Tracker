# Copy this file to .env and replace the placeholder values with your own.
# Never commit your real .env file.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/expensedb?retryWrites=true&w=majority

# Secret used to sign login tokens. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login token stays valid (e.g. 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# OPTIONAL: database used by "npm test". If you leave this out, the tests use
# MONGO_URI with the database name changed to "expensedb_test".
# The database name MUST end in "_test" or the tests refuse to run.
# MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster-host>/expensedb_test?retryWrites=true&w=majority
